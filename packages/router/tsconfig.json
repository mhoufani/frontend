{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist",
    "target": "ESNext",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ESNext"],
  },
  "include": ["**/*.js", "**/*.ts", "jest.config.mjs"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
