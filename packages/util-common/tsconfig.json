{
  "compilerOptions": {
    "baseUrl": "./src",
    "outDir": "./dist",
    "target": "es2016",
    "module": "CommonJS",
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@checker": ["checker/index"],
      "@entity": ["entity/index"],
      "@storage": ["storage/index"],
      "@formatter": ["formatter/index"]
    }
  },
  "include": ["**/*.js", "**/*.ts"]
}
