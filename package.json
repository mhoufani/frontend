{
	"name": "mp-frontend",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean:deps": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
		"dev": "turbo run dev",
		"check-types": "tsc --noEmit",
		"build": "turbo run build",
		"test": "turbo run test --filter=@repo/util-common",
		"test:utils": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=utils --watchAll --silent=false"
	},
	"devDependencies": {
		"@testing-library/jest-dom": "^6.6.3",
		"eslint-config-prettier": "^9.1.0",
		"globals": "^15.15.0",
		"jest": "^29.7.0",
		"prettier": "^3.5.3",
		"ts-node": "^10.9.2",
		"turbo": "^2.5.3",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.32.1"
	},
	"packageManager": "pnpm@10.11.0",
	"engines": {
		"node": ">=18.18.0",
		"pnpm": ">=9.0.0"
	}
}
