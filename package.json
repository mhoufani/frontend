{
	"name": "mp-frontend",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"clean:deps": "find . -name \"node_modules\" -type d -prune -exec rm -rf '{}' +",
		"dev": "turbo run dev",
		"check-types": "tsc --noEmit",
		"build": "turbo run build",
		"test": "turbo run test --filter=@repo/util-common",
		"test:utils": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects=utils --watchAll --silent=false"
	},
	"devDependencies": {
		"@eslint/js": "^9.11.1",
		"@types/eslint__js": "^8.42.3",
		"@types/node": "^22.7.4",
		"eslint": "^9.11.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-turbo": "^2.1.2",
		"globals": "^15.14.0",
		"jest": "^29.7.0",
		"jest-dom": "^4.0.0",
		"prettier": "^3.3.3",
		"ts-node": "^10.9.2",
		"turbo": "^2.1.2",
		"typescript": "^5.6.2",
		"typescript-eslint": "^8.8.0"
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18.18.0",
		"pnpm": ">=9.0.0"
	}
}
